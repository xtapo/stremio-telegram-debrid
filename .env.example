# Port the addon server runs on (Default: 7860)
PORT=7860

# Public URL of your deployed addon (e.g., https://stremio-tg.yourdomain.com)
ADDON_URL=http://localhost:7860

# Dashboard Login & Admin Security (Tùy chọn)
# DASHBOARD_USERNAME: Tên đăng nhập quản trị Dashboard (Mặc định: admin)
DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD: Mật khẩu bảo vệ truy cập Dashboard và API quản lý (Để trống nếu không cần mật khẩu)
DASHBOARD_PASSWORD=

# Optional API Key to secure your addon (e.g., Gvi4ShwFyYz...)
API_KEY=

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Telegram Bot Token from @BotFather (required if USER_SESSION_STRING is not set)
BOT_TOKEN=

# Telegram User Session String (highly recommended to bypass 2GB file limit)
USER_SESSION_STRING=

# Comma-separated list of Telegram Channel IDs to index (e.g., -100xxxxxxxxxx, -100yyyyyyyyyy)
TELEGRAM_CHANNEL_ID=

# Optional: Channel ID to send play/stream logs to (e.g., -100zzzzzzzzzz)
LOG_CHANNEL_ID=

# Optional: Timezone for logging (e.g., Asia/Kolkata, UTC). Defaults to UTC.
TIMEZONE=UTC

# Optional: Cache duration in seconds for search queries (Default: 1800)
CACHE_TTL=1800

# API Key của nhà cung cấp Debrid (Yêu cầu tài khoản trả phí cho cả Real-Debrid và TorBox để dùng API)
REAL_DEBRID_API_KEY=
TORBOX_API_KEY=your_torbox_api_key

# Tự động tải từ Debrid và upload ngược lên kênh Telegram riêng tư của bạn (True/False)
AUTO_UPLOAD_TO_TELEGRAM=True

# Giới hạn số lượng kết quả torrent hiển thị trên Stremio (Mặc định: 10)
MAX_TORRENT_RESULTS=10

# Cấu hình tìm kiếm torrent nâng cao nếu bạn dùng Jackett/Prowlarr (Tùy chọn)
JACKETT_URL=
JACKETT_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=

# qBittorrent Settings
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASS=adminadmin

# Optional path mapping (leave empty if addon runs on the same system)
QBITTORRENT_PLAY_DIR=

# Subtitle & Auto Vietnamese Subtitle & AI Voiceover generation settings (Optional)
# ENABLE_SUBTITLES: Bật/tắt toàn bộ tính năng phụ đề của addon trên Stremio (Default: True)
ENABLE_SUBTITLES=True

# AUTO_VIET_SUB: Set to True to enable automatic translation/generation of Vietnamese subtitles (Default: True)
AUTO_VIET_SUB=True

# AUTO_THUYET_MINH: Bật/tắt thuyết minh giọng đọc AI đọc phụ đề Tiếng Việt (Default: True)
AUTO_THUYET_MINH=True

# Bật/tắt các engine dịch AI (True = Bật, False = Tắt)
ENABLE_GEMINI=True
ENABLE_CUSTOM_AI=True

# GEMINI_API_KEY: Optional Gemini API Key for high-quality translation and audio transcription when no subtitles exist
GEMINI_API_KEY=
# GEMINI_MODEL: Tên model Gemini dùng cho track 2 và phiên âm audio (Mặc định: gemini-3.5-flash)
# Đặt tên model mới nhất mà API key của bạn truy cập được vào đây.
GEMINI_MODEL=gemini-3.5-flash

# Custom AI Translation API Settings (Optional)
# CUSTOM_AI_API_URL: Custom endpoint URL (e.g., http://localhost:20128/v1/chat/completions)
CUSTOM_AI_API_URL=
# CUSTOM_AI_API_KEY: Authorization Bearer Token for custom endpoint
CUSTOM_AI_API_KEY=
# CUSTOM_AI_MODEL: Custom AI model name (Default: cc/claude-opus-4-6)
CUSTOM_AI_MODEL=cc/claude-opus-4-6
# CUSTOM_AI_STREAM: Enable streaming translation response (True/False, Default: True)
CUSTOM_AI_STREAM=True
# SUBTITLE_TRANSLATION_SOURCE: Source to translate from ('sub' for existing subtitles, 'audio' to transcribe audio directly, Default: sub)
SUBTITLE_TRANSLATION_SOURCE=sub

# ------------------------------------------------------------------
# Đồng bộ thời gian phụ đề (Tùy chọn)
# ------------------------------------------------------------------
# SUBTITLE_TIME_OFFSET: Dịch thời gian phụ đề, tính bằng giây (Mặc định: 0)
# Số dương = phụ đề hiện MUỘN hơn, số âm = hiện SỚM hơn.
# Ví dụ: 1.5 nếu phụ đề luôn chạy nhanh hơn thoại 1.5 giây.
SUBTITLE_TIME_OFFSET=0

# ------------------------------------------------------------------
# Hai track phụ đề tiếng Việt (Tùy chọn)
# Track 1 "Nhanh": Lingva dịch TOÀN BỘ phim đa luồng rồi trả về một lần.
# Track 2 "AI chất lượng cao": cũng đưa TOÀN BỘ file cho Gemini -> Custom AI
#          trong một lượt, các chunk chạy song song, câu nào chưa tới lượt thì
#          tạm dùng bản Lingva của track 1.
# ------------------------------------------------------------------
# SYNC_VTT_LINGVA_CONCURRENCY: Số lô dịch song song của track 1 (Mặc định: 8)
# Tăng cho nhanh hơn; giảm xuống 4 nếu Lingva báo lỗi / chặn tần suất.
SYNC_VTT_LINGVA_CONCURRENCY=8
# SYNC_VTT_LINGVA_BATCH: Số câu thoại mỗi lô gửi cho Lingva (Mặc định: 40)
SYNC_VTT_LINGVA_BATCH=40
# SYNC_VTT_AUTO_QUALITY: Tự động chạy track 2 ngay sau khi track 1 xong (Mặc định: True)
# Đặt False nếu chỉ muốn track 2 chạy khi bạn bấm chọn nó trong Stremio.
SYNC_VTT_AUTO_QUALITY=True
# SYNC_VTT_QUALITY_ONE_PASS: Đưa cả file cho AI trong một lượt (Mặc định: True)
# True = nhanh nhất, các chunk chạy song song theo SYNC_VTT_GEMINI_CONCURRENCY.
# False = quay về kiểu cũ: dịch tuần tự tứng lô SYNC_VTT_BACKGROUND_SLICE câu,
#         chậm hơn nhưng nhẹ quota hơn nếu API của bạn bị chặn tần suất.
SYNC_VTT_QUALITY_ONE_PASS=True
# SYNC_VTT_BACKGROUND_SLICE: Chỉ dùng khi SYNC_VTT_QUALITY_ONE_PASS=False (Mặc định: 150)
SYNC_VTT_BACKGROUND_SLICE=150
# Chunk / số luồng của hai engine AI ở track 2.
# Gặp lỗi 429 (quota) thì giảm CONCURRENCY xuống 2.
SYNC_VTT_GEMINI_CHUNK=150
SYNC_VTT_GEMINI_CONCURRENCY=4
SYNC_VTT_CUSTOM_CHUNK=100
SYNC_VTT_CUSTOM_CONCURRENCY=3
# Hai biến cũ của luồng "dịch trước phần đầu phim", nay chỉ còn để tương thích.
SYNC_VTT_HEAD_SECONDS=300
SYNC_VTT_HEAD_MAX_BLOCKS=400

# ==================================================================
# MOVIESDRIVE
# Tất cả biến MD_* đều được đọc trực tiếp từ biến môi trường (không qua
# Config) và đều có mặc định hợp lý. Chỉ cần đặt khi nguồn đổi tên miền,
# đổi layout, hoặc khi mạng/VPS của bạn yếu.
# Xem trạng thái thực tế tại: GET /moviesdrive/cache_stats
# ==================================================================

# ------------------------------------------------------------------
# 1. Tên miền & mirror (QUAN TRỌNG NHẤT)
# MoviesDrive đổi tên miền liên tục. Khi addon không tải được dữ liệu,
# 90% là do tên miền cũ đã chết -> chỉ cần sửa MD_BASE_URL rồi restart.
# ------------------------------------------------------------------
# MD_PORTAL_URL: trang chủ điều hướng chính thức để tự động bóc tách tên miền mới nhất
MD_PORTAL_URL=https://moviesdrives.cfd
# MD_BASE_URL: tên miền chính đang sống (ví dụ: https://new4.moviesdrive.christmas)
MD_BASE_URL=
# MD_MIRRORS: danh sách mirror dự phòng, cách nhau bằng dấu phẩy
MD_MIRRORS=
# MD_MIRROR_TEMPLATES: mẫu sinh mirror tự động, {n} sẽ được thay bằng số
# Ví dụ: https://new{n}.moviesdrive.christmas,https://moviesdrive{n}.mov
MD_MIRROR_TEMPLATES=
# MD_MIRROR_RANGE: khoảng số dùng cho {n} (Mặc định: 1-6)
MD_MIRROR_RANGE=1-6
# Dò tên miền sống: đường dẩn dùng để thử, timeout mỗi lần thử,
# thời gian nhớ kết quả, và số miền thử tối đa mỗi lần dò
MD_BASE_PROBE_PATH=/
MD_BASE_PROBE_TIMEOUT=6.0
MD_BASE_DISCOVERY_TTL=900.0
MD_MAX_DISCOVERY_PROBES=12
# Miền lỗi MD_BASE_MAX_FAILURES lần sẽ bị nghỉ MD_BASE_COOLDOWN giây
MD_BASE_MAX_FAILURES=3
MD_BASE_COOLDOWN=300.0
# Số mirror chạy đua song song cho mỗi request (Mặc định: 4)
MD_MAX_RACE_MIRRORS=4

# ------------------------------------------------------------------
# 2. Chống Cloudflare / anti-bot
# Nếu máy chủ trả về trang "Just a moment..." (HTTP 200 nhưng rỗng ruột),
# addon sẽ coi đó là thất bại thay vì ghim mirror đó lại.
# ------------------------------------------------------------------
# MD_MIN_HTML_LENGTH: HTML ngắn hơn mức này bị coi là không dùng được
MD_MIN_HTML_LENGTH=400
# MD_BLOCK_MARKERS: chuỗi nhận biết trang chặn, cách nhau bằng dấu phẩy
MD_BLOCK_MARKERS=
# MD_ANTIBOT_FALLBACK: bật dự phòng vượt chặn (Mặc định: true)
MD_ANTIBOT_FALLBACK=true
# MD_IMPERSONATE: profile TLS của curl_cffi (cần `pip install curl_cffi`)
MD_IMPERSONATE=chrome120
# MD_FLARESOLVERR_URL: ví dụ http://localhost:8191/v1 (để trống = không dùng)
MD_FLARESOLVERR_URL=
MD_FLARESOLVERR_TIMEOUT=40.0

# ------------------------------------------------------------------
# 3. Selector & đường dẩn (chỉ cần đặt khi web đổi layout)
# Dấu hiệu: log báo "parsed 0 cards" nhưng tên miền vẫn sống.
# ------------------------------------------------------------------
# MD_CARD_SELECTORS: CSS selector của thẻ phim, thử lần lượt, cách nhau bằng phẩy
MD_CARD_SELECTORS=
# MD_LINK_SELECTORS: selector dự phòng theo link tiêu đề bài viết
MD_LINK_SELECTORS=
# Slug chuyên mục (Mặc định: /category/ + movies | web | 2160p-4k)
MD_CATEGORY_PREFIX=/category/
MD_CATEGORY_MOVIES=movies
MD_CATEGORY_SERIES=web
MD_CATEGORY_4K=2160p-4k
# MD_GENRE_MAP: JSON ghi đè bản đồ thể loại -> slug
# Ví dụ: {"Sci-Fi": "sci-fi", "Thriller": "thriller"}
MD_GENRE_MAP=
# Đường dẩn tìm kiếm: JSON trước, không được thì tự chuyển sang trang HTML
MD_SEARCH_PATH=/search.php?q={query}&page={page}
MD_SEARCH_HTML_PATH=/page/{page}/?s={query}
# MD_BUTTON_HOSTS: các host được coi là nút tải trên trang phim
MD_BUTTON_HOSTS=

# ------------------------------------------------------------------
# 4. HubCloud / GamerXYT / CDN (tầng giải link)
# ------------------------------------------------------------------
MD_HUBCLOUD_BASE=https://hubcloud.cx
MD_HUBCLOUD_SEARCH_PATH=/drive/search-recover.php
MD_GAMERXYT_BASE=https://gamerxyt.com
# MD_GAMERXYT_HOSTS / MD_FSL_HOSTS / MD_WORKER_HOSTS / MD_DIRECT_HOSTS:
# danh sách host để nhận ra link phát được (cách nhau bằng dấu phẩy)
MD_GAMERXYT_HOSTS=
MD_FSL_HOSTS=
MD_WORKER_HOSTS=
MD_DIRECT_HOSTS=

# ------------------------------------------------------------------
# 5. Timeout & pool kết nối
# Timeout tách riêng: mirror chết sẽ trượt sau MD_CONNECT_TIMEOUT giây
# ------------------------------------------------------------------
MD_CONNECT_TIMEOUT=3.0
MD_READ_TIMEOUT=12.0
MD_POOL_TIMEOUT=5.0
MD_REQUEST_RETRIES=1
# Pool kết nối dùng chung (giảm xuống nếu VPS yếu)
MD_MAX_CONNECTIONS=40
MD_MAX_KEEPALIVE=20
MD_KEEPALIVE_EXPIRY=90.0
# Timeout của /moviesdrive/stream_proxy khi phát video
MD_PROXY_TIMEOUT=60.0
# MD_NO_REFERER_HOSTS: host tự chối header Referer (link R2/S3 có ký)
MD_NO_REFERER_HOSTS=

# ------------------------------------------------------------------
# 6. Cache
# TTL mặc định, TTL cho kết quả rỗng, và TTL cho link stream đã giải mã
# ------------------------------------------------------------------
MD_CACHE_TTL=300
MD_NEGATIVE_TTL=60
MD_STREAM_CACHE_TTL=1800
MD_CACHE_MAX_ENTRIES=2000
MD_CACHE_SAVE_INTERVAL=15.0
MD_CACHE_PERSIST_MIN_TTL=600
# Đường dẩn file cache ghi xuống đĩa (mặc định: moviesdrive_cache.json trong thư mục tạm)
# Đặt vào volume bền nếu chạy Docker để restart không mất cache.
MD_CACHE_FILE=

# ------------------------------------------------------------------
# 7. Catalog, meta và phân trang
# ------------------------------------------------------------------
# TTL cho catalog, meta và bản đồ slug -> IMDb
MD_CATALOG_TTL=300
MD_CATALOG_STALE_TTL=1800
MD_SEARCH_TTL=600
MD_META_TTL=900
MD_META_STALE_TTL=7200
MD_CINEMETA_TTL=3600
MD_IMDB_TTL=86400
MD_IMDB_NEGATIVE_TTL=600
MD_SUBS_TTL=900
# Số phim trả về mỗi lần Stremio cuộn (Mặc định: 20)
MD_CATALOG_PAGE_SIZE=20
# MD_ITEMS_PER_PAGE chỉ là giá trị khởi đầu; số thật được học từ trang 1
MD_ITEMS_PER_PAGE=24
# Thời gian chờ lấy poster/điểm IMDb cho lô đầu (Mặc định: 6.0 giây)
MD_META_ENRICH_TIMEOUT=6.0
MD_META_ENRICH_COUNT=8
# Số tập giả định khi trang phim bộ không cho biết số tập (Mặc định: 1)
# Đặt 0 để không tạo tập nào khi không đọc được.
MD_FALLBACK_EPISODES=1

# ------------------------------------------------------------------
# 8. Luồng phát & thông báo lỗi
# ------------------------------------------------------------------
# Số luồng hiển thị tối đa và số luồng được giải mã sẵn chạy nền
MD_MAX_CANDIDATES=6
MD_WARM_CANDIDATES=2
MD_MAX_HC_BUTTONS=3
# MD_SHOW_ERRORS: hiện một dòng giải thích trong Stremio khi không lấy được
# link, thay vì danh sách trống không rõ nguyên nhân (Mặc định: true)
MD_SHOW_ERRORS=true

# ==================================================================
# HDTODAY (hdtoday.sc) - Kho Phim & Series Quốc Tế
# ==================================================================
# Bật/Tắt nguồn HDToday (Mặc định: True)
ENABLE_SOURCE_HDTODAY=True
# Bật/Tắt hiển thị danh mục HDToday trên Trang chủ (Board) của Stremio (Mặc định: True)
ENABLE_BOARD_HDTODAY=True
# Tên miền HDToday (Mặc định: https://hdtoday.sc)
HDTODAY_BASE_URL=https://hdtoday.sc

# ==================================================================
# VIDKING PLAYER (vidking.net) - Kho Phim & TV Series 4K / 1080p
# ==================================================================
# Bật/Tắt nguồn Vidking Player (Mặc định: True)
ENABLE_SOURCE_VIDKING=True
# Bật/Tắt hiển thị danh mục Vidking trên Trang chủ (Board) của Stremio (Mặc định: True)
ENABLE_BOARD_VIDKING=True

# ==================================================================
# ERNAX PLAYER (ernax.pro) - Kho Phim & TV Series 4K UHD / 1080p
# ==================================================================
# Bật/Tắt nguồn Ernax Player (Mặc định: True)
ENABLE_SOURCE_ERNAX=True
# Bật/Tắt hiển thị danh mục Ernax trên Trang chủ (Board) của Stremio (Mặc định: True)
ENABLE_BOARD_ERNAX=True

# ==================================================================
# FILM4K LIVE TV (film4k.net/tv) - 200+ Kênh Truyền Hình & Sự Kiện Trực Tiếp
# ==================================================================
# Bật/Tắt nguồn Film4k Live TV (Mặc định: True)
ENABLE_SOURCE_FILM4K_TV=True
# Bật/Tắt hiển thị danh mục Film4k trên Trang chủ (Board) của Stremio (Mặc định: True)
ENABLE_BOARD_FILM4K_TV=True
# Tên miền Film4k (Mặc định: https://film4k.net)
FILM4K_BASE_URL=https://film4k.net
# Cookie phiên đăng nhập Film4k (session=...) dùng để xác thực lấy link luồng phát HLS
FILM4K_COOKIE=session=eyJhbGciOiJIUzI1NiJ9...

# ==================================================================
# UHDMOVIES (uhdmovies.autos) - 4K UHD, 2160p HEVC, 1080p 10Bit, 60FPS
# ==================================================================
# Bật/Tắt nguồn UHDMovies (Mặc định: True)
ENABLE_SOURCE_UHDMOVIES=True
# Bật/Tắt hiển thị danh mục UHDMovies trên Trang chủ (Board) của Stremio (Mặc định: True)
ENABLE_BOARD_UHDMOVIES=True
# Tên miền chính UHDMovies (Mặc định: https://uhdmovies.autos)
UHDMOVIES_BASE_URL=https://uhdmovies.autos

# ==================================================================
# 4KHDHUB (4khdhub.one) - 4K Ultra HD 2160p, Dolby Vision, HDR10+, 1080p HEVC REMUX
# ==================================================================
# Bật/Tắt nguồn 4KHDHub (Mặc định: True)
ENABLE_SOURCE_4KHDHUB=True
# Bật/Tắt hiển thị danh mục 4KHDHub trên Trang chủ (Board) của Stremio (Mặc định: True)
ENABLE_BOARD_4KHDHUB=True
# Tên miền chính 4KHDHub (Mặc định: https://4khdhub.one)
FOURKHDHUB_BASE_URL=https://4khdhub.one

# ==================================================================
# MOVIES2WATCH (movies2watch.vc) - Phim Lẻ & Series Truyền Hình Full HD / Đa Server
# ==================================================================
# Bật/Tắt nguồn Movies2Watch (Mặc định: True)
ENABLE_SOURCE_MOVIES2WATCH=True
# Bật/Tắt hiển thị danh mục Movies2Watch trên Trang chủ (Board) của Stremio (Mặc định: True)
ENABLE_BOARD_MOVIES2WATCH=True
# Tên miền chính Movies2Watch (Mặc định: https://movies2watch.vc)
MOVIES2WATCH_BASE_URL=https://movies2watch.vc

# ==================================================================
# TVRUN (tvrun.online) - Free Global Live TV Streaming (200+ Nước, Free-TV, YouTube Live)
# ==================================================================
# Bật/Tắt nguồn TVRun Global Live TV (Mặc định: True)
ENABLE_SOURCE_TVRUN=True
# Bật/Tắt hiển thị danh mục TVRun trên Trang chủ (Board) của Stremio (Mặc định: True)
ENABLE_BOARD_TVRUN=True
# Tên miền chính TVRun (Mặc định: https://tvrun.online)
TVRUN_BASE_URL=https://tvrun.online

# ==================================================================
# KKPHIM & PHIMAPI (phimapi.com) - Kho Phim Lẻ, Phim Bộ, Hoạt Hình & TV Shows Lớn Nhất
# ==================================================================
# Bật/Tắt nguồn KKPhim (Mặc định: True)
ENABLE_SOURCE_KKPHIM=True
# Bật/Tắt hiển thị danh mục KKPhim trên Trang chủ (Board) của Stremio (Mặc định: True)
ENABLE_BOARD_KKPHIM=True

# ==================================================================
# RIDOMOVIES (ridomovies.su) - Phim Lẻ & Series Truyền Hình Tiếng Anh HD / 4K
# ==================================================================
# Bật/Tắt nguồn RidoMovies (Mặc định: True)
ENABLE_SOURCE_RIDOMOVIES=True
# Bật/Tắt hiển thị danh mục RidoMovies trên Trang chủ (Board) của Stremio (Mặc định: True)
ENABLE_BOARD_RIDOMOVIES=True

# ==================================================================
# CLB PHIM XƯA (clbphimxua.com) - Tuyển Tập Phim Kinh Điển & Phim Xưa Truyền Hình
# ==================================================================
# Bật/Tắt nguồn CLBPhimXua (Mặc định: True)
ENABLE_SOURCE_CLBPHIMXUA=True
# Bật/Tắt hiển thị danh mục CLBPhimXua trên Trang chủ (Board) của Stremio (Mặc định: True)
ENABLE_BOARD_CLBPHIMXUA=True

# ==================================================================
# YANHH3D (yanhh3d.run) - Kho Hoạt Hình 3D Trung Quốc (Donghua) Siêu Nét 4K
# ==================================================================
# Bật/Tắt nguồn Yanhh3d 3D Donghua (Mặc định: True)
ENABLE_SOURCE_YANHH3D=True
# Bật/Tắt hiển thị danh mục Yanhh3d trên Trang chủ (Board) của Stremio (Mặc định: True)
ENABLE_BOARD_YANHH3D=True



